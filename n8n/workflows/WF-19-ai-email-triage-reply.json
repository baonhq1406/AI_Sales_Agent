            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-120b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are the AI Email Triage Assistant for an AI Sales Agent system. Analyze the customer's email and classify its intent. The intent must be exactly one of: question, complaint, agreement, other. Then create a short summary and a professional draft reply. Do not send the email. Return ONLY valid JSON with these fields: intent, confidence, summary, draft_reply. confidence must be a number between 0 and 1.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"From: {{ $('Authentication').item.json.from }}\\nSubject: {{ $('Authentication').item.json.subject }}\\nEmail body: {{ $('Authentication').item.json.body }}\"\n    }\n  ],\n  \"temperature\": 0.2,\n  \"response_format\": {\n    \"type\": \"json_object\"\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1024,
        -224
      ],
      "id": "434c0e54-f672-42c5-beca-80c0616852be",
