    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const email = item.json;\n\n  // Lấy nội dung email ưu tiên từ textPlain,\n  // nếu không có thì dùng snippet của Gmail.\n  const body =\n    email.textPlain ||\n    email.text ||\n    email.snippet ||\n    '';\n\n  // Tạo correlation_id để trace xuyên suốt WF-19\n  const correlationId =\n  'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    const r = Math.floor(Math.random() * 16);\n    const v = c === 'x' ? r : (r & 0x3) | 0x8;\n    return v.toString(16);\n  });\n\n  return {\n    json: {\n      message_id: email.id || '',\n      thread_id: email.threadId || '',\n      from: email.From || email.from || '',\n      to: email.To || email.to || '',\n      subject: email.Subject || email.subject || '',\n      body: body.trim(),\n      received_at: new Date().toISOString(),\n      correlation_id: correlationId,\n      workflow: 'WF-19',\n      source: 'gmail'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -208
      ],
      "id": "f5a8e0e9-549f-4b07-8122-bdc6bcbcd4a1",
