    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, customer_name, customer_email, company_name, items, subtotal, discount_percent, total_amount, created_at\nFROM quotations\nWHERE id = '{{ $json.body.quote_id }}'::uuid;",
